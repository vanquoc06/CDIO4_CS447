{
  "compilerOptions": {
    /* Môi trường & Phiên bản */
    "target": "es2020",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    /* Thư mục gốc và thư mục Build */
    "rootDir": "./src",
    "outDir": "./dist",

    /* Kiểm tra kiểu dữ liệu (Strict Mode) */
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "**/*.spec.ts"
  ]
}